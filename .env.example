# ── Base de données ───────────────────────────────────────────────────────────
# N'importe quel Postgres. Avec Supabase : Project Settings → Database →
# Connection string → URI (pooler). Sur Vercel, l'intégration Supabase fournit
# la même valeur sous le nom POSTGRES_URL, qui sert de repli automatique.
DATABASE_URL=postgresql://postgres.xxxx:MOTDEPASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# ── Administration ────────────────────────────────────────────────────────────
# Le mot de passe unique de /admin. Le changer déconnecte au prochain login.
ADMIN_PASSWORD=
# Clé de signature du cookie de session. La changer révoque toutes les sessions.
# Générer avec : openssl rand -base64 32
AUTH_SECRET=

# ── Site ──────────────────────────────────────────────────────────────────────
# URL canonique, sans barre oblique finale. Sert aux métadonnées de partage et
# à `event_source_url` des événements Meta.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Meta (facultatif) ─────────────────────────────────────────────────────────
# Repli utilisé tant que rien n'est saisi dans /admin/reglages. Les valeurs de
# l'administration ont toujours la priorité : elles se changent sans
# redéploiement, ce que ces variables ne permettent pas (Vercel les fige au build).
META_PIXEL_ID=
META_CAPI_TOKEN=
